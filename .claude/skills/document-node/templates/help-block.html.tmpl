<script type="text/x-red" data-help-name="rp-{{name}}">
  <p>{{summary_one_sentence}}</p>

  <h3>Details</h3>
  <p>{{details_paragraph}}</p>

  <h3>Properties</h3>
  <dl class="message-properties">
{{properties_dl_entries}}
  </dl>

  <h3>Inputs</h3>
  <dl class="message-properties">
    <dt>payload <span class="property-type">{{input_type}}</span></dt>
    <dd>{{input_description}}</dd>
  </dl>

  <h3>Outputs</h3>
  <dl class="message-properties">
    <dt>payload <span class="property-type">{{output_type}}</span></dt>
    <dd>{{output_description}}</dd>
  </dl>

  <h3>Examples</h3>
  <ul>
{{examples_li_entries}}
  </ul>

  <h3>Performance</h3>
  <p>{{performance_paragraph}}</p>

  <h3>Error Handling</h3>
  <p>On invalid input or processing failure, <code>msg.error</code> is populated with <code>{ message, hint, details, operation, nodeId, nodeType, timestamp }</code> and the original payload is passed through unchanged so the flow continues.</p>
</script>
